# Use an Ethereum Mainnet RPC endpoint from a provider you trust.
ETHEREUM_RPC_URL=

# Optional: scan from this block on the first run. If empty, starts at current eligible tip.
START_BLOCK=

# Polling interval in seconds and number of blocks held back for confirmation.
POLL_SECONDS=2
CONFIRMATIONS=2

# SQLite file path.
DATABASE_PATH=data/megan.sqlite3

# Optional comma-separated factory addresses. Configure only verified factory contracts.
# V2 factory emits PairCreated(address,address,address,uint256).
V2_FACTORY_ADDRESSES=
# V3 factory emits PoolCreated(address,address,uint24,int24,address).
V3_FACTORY_ADDRESSES=
