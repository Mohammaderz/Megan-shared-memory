# Ethereum Mainnet RPC. For full CREATE/CREATE2 coverage, use a tracing-capable RPC.
ETHEREUM_RPC_URL=
START_BLOCK=

# 0 means inspect each deployment in its first mined block (not the pending mempool).
POLL_SECONDS=2
CONFIRMATIONS=0
DATABASE_PATH=data/megan.sqlite3

# Configure only verified DEX factory addresses. V3 here means pool events, not position NFTs.
V2_FACTORY_ADDRESSES=
V3_FACTORY_ADDRESSES=

TRACE_MODE=auto
TRACE_REQUIRED=true

# Optional social enrichment keys.
# DEX Screener latest token profiles are queried without a key.
DEXTOOLS_API_KEY=
# X recent-post search requires an X API bearer token.
X_BEARER_TOKEN=

# Optional Telegram global group search using your own local MTProto user session.
# Create API credentials at https://my.telegram.org; never share the session file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_FILE=data/telegram_user
