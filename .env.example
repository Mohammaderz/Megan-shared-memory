# Ethereum Mainnet only (chain_id=1)
ETHEREUM_RPC_URL=
START_BLOCK=
POLL_SECONDS=2
CONFIRMATIONS=2
DATABASE_PATH=data/megan.sqlite3

# Verified Ethereum DEX factory contracts only
V2_FACTORY_ADDRESSES=
V3_FACTORY_ADDRESSES=
TRACE_MODE=auto
TRACE_REQUIRED=false

# Fast alert intake: comma-separated public RSS/Atom feed URLs
RSS_ALERT_FEEDS=
# Public Telegram channel usernames/links, comma-separated (e.g. channelname,@anotherchannel)
TELEGRAM_CHANNELS=
# Optional Telegram user-session credentials. Install with: pip install -e ".[telegram]"
# Create/authorize the session locally; never commit .env or the session file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram_session
